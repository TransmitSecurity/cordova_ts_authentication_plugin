<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns="http://apache.org/cordova/ns/plugins/1.0"
        id="cordova-ts-authentication"
        version="1.0.0">

    <name>cordova-ts-authentication</name>
    <description>Transmit Security Authentication (A+) Cordova plugin</description>
    <license>MIT</license>

    <engines>
        <!-- cordova-android 12+ is required: CordovaActivity must extend
             AppCompatActivity (a FragmentActivity) for the native biometric
             prompt. See src/android/TSAuthPlugin.kt. -->
        <engine name="cordova-ios"     version=">=8.0.0"  />
        <engine name="cordova-android" version=">=12.0.0" />
    </engines>

    <js-module src="www/tsauth-plugin/authentication-api.js" name="tsauth">
        <clobbers target="cordova.tsauth" />
    </js-module>

    <!-- Cordova prepare only copies declared js-module files into platforms/*/www/plugins/. -->
    <js-module src="www/tsauth-plugin/lib/logger.js" name="tsauth-logger" />
    <js-module src="www/tsauth-plugin/lib/errors.js" name="tsauth-errors" />
    <js-module src="www/tsauth-plugin/lib/bridge.js" name="tsauth-bridge" />

    <!-- Enables Kotlin in the Cordova app module so TSAuthPlugin.kt compiles. -->
    <!-- Cordova resets IS_GRADLE_PLUGIN_KOTLIN_ENABLED=false on every prepare; this re-enables it. -->
    <hook type="after_prepare" src="scripts/enable-android-kotlin.js" />
    <!-- Keep Gradle wrapper on cordova-android's pinned version (AS may bump it to 9.x and break sync). -->
    <hook type="after_prepare" src="scripts/pin-android-gradle-wrapper.js" />
    <!-- cordova-ios always generates empty Podfile/Pods even for SPM-only plugins; strip them. -->
    <hook type="after_prepare" src="scripts/remove-unused-ios-cocoapods.js" />

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="TSAuthPlugin">
                <param name="android-package" value="com.transmitsecurity.tsauth.TSAuthPlugin" />
                <param name="onload" value="true" />
            </feature>
        </config-file>

        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
            <uses-permission android:name="android.permission.USE_BIOMETRIC" />
        </config-file>

        <source-file src="src/android/TSAuthPlugin.kt"
                     target-dir="app/src/main/kotlin/com/transmitsecurity/tsauth" />
        <framework src="src/android/cordova-ts-authentication.gradle"
                   custom="true" type="gradleReference" />
    </platform>

    <platform name="ios" package="swift">
        <config-file target="config.xml" parent="/*">
            <feature name="TSAuthPlugin">
                <param name="ios-package" value="TSAuthPlugin" />
                <param name="onload" value="true" />
            </feature>
        </config-file>
        <!-- Required whenever Face ID is used (native biometrics, biometric-protected
             TOTP). Override in your own config.xml to change the wording. -->
        <config-file target="*-Info.plist" parent="NSFaceIDUsageDescription">
            <string>Used to authenticate you with Face ID.</string>
        </config-file>
    </platform>
</plugin>
